IMMICH_URL=http://localhost:2283
# needs: stack.read stack.create stack.update stack.delete asset.read asset.view asset.delete face.read
IMMICH_API_KEY=changeme

# stack builder: consecutive shots chain into a candidate group when they are within
# TIME_WINDOW_S and, when both carry GPS, within LOCATION_RADIUS_M of each other
TIME_WINDOW_S=120
LOCATION_RADIUS_M=30
# candidates become a stack when CLIP cosine similarity reaches SIM_THRESHOLD
SIM_THRESHOLD=0.85
EMBED_MODEL=ViT-B-32/openai
# chain: walk frames in upload order, a frame joins the latest chain whose last frame it matches
# complete: a frame must match every frame already in the cluster
CLUSTER_MODE=chain

# container mode, 0 disables. sync re-scores stacks; build stacks photos taken in the
# last BUILD_WINDOW_DAYS that are not stacked yet (never dissolves or replaces on its own)
SYNC_EVERY_MIN=360
BUILD_EVERY_MIN=60
BUILD_WINDOW_DAYS=14

# 1 adds the LAION aesthetic head (CLIP ViT-L/14, 1.7 GB download) to the scorer
USE_AESTHETIC=0
WORKERS=8
DB_PATH=data/selector.sqlite
CACHE_DIR=data/thumbs
