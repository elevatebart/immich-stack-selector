IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=changeme
# stack builder: frames chain into a candidate group when consecutive shots are
# within TIME_WINDOW_S and (when both have GPS) LOCATION_RADIUS_M of each other
TIME_WINDOW_S=120
LOCATION_RADIUS_M=10
# candidates become a stack only when CLIP cosine similarity >= SIM_THRESHOLD
SIM_THRESHOLD=0.90
EMBED_MODEL=ViT-B-32/openai
# 1 enables CLIP + LAION aesthetic head (needs `uv sync --extra aesthetic`)
USE_AESTHETIC=0
WORKERS=8
DB_PATH=data/selector.sqlite
CACHE_DIR=data/thumbs
